{
  "name": "@sveltekit-i18n/typegen",
  "version": "3.0.0",
  "description": "Generates the TranslationSchema type for sveltekit-i18n from an app's own translation files.",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pretest": "npm run build && npm run typecheck",
    "test": "vitest run",
    "build": "tsup",
    "prepublishOnly": "npm run build",
    "lint": "eslint --fix .",
    "prepare": "simple-git-hooks"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/sveltekit-i18n/typegen.git"
  },
  "keywords": [
    "svelte",
    "sveltekit",
    "vite-plugin",
    "i18n",
    "typescript",
    "codegen",
    "sveltekit-i18n"
  ],
  "author": "Jarda Svoboda",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/sveltekit-i18n/lib/issues"
  },
  "homepage": "https://sveltekit-i18n.github.io",
  "funding": "https://github.com/sponsors/sveltekit-i18n",
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@sveltejs/kit": "^2.0.0",
    "@sveltekit-i18n/base": "^3.0.0",
    "vite": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "@sveltejs/kit": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@sveltejs/adapter-node": "^5.3.4",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@sveltekit-i18n/base": "^3.0.0",
    "@types/node": "^26.2.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "eslint-plugin-import-x": "^4.17.1",
    "globals": "^17.11.0",
    "simple-git-hooks": "^2.13.1",
    "svelte": "^5.56.9",
    "sveltekit-i18n": "^3.0.0",
    "tsup": "^8.0.1",
    "typescript": "^5.1.6",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "simple-git-hooks": {
    "pre-commit": "npm run lint"
  }
}
